    {
      "line": 71,
      "text": "/** The official list declaration has a String cursor and integer count/scene."
    },
    {
      "line": 72,
      "text": " * Keep the proved scene enum: default=0 (compatibility), Douyin=1, Luna=2."
    },
    {
      "line": 73,
      "text": " * The App sends an explicit empty first-page cursor, then reuses server cursors."
    },
    {
      "line": 74,
      "text": " * Match its 256-character/no-whitespace bound without rebuilding signed bytes."
    },
    {
      "line": 75,
      "text": " */"
    },
    {
      "line": 76,
      "text": "function validateSocialQuery(params) {"
    },
    {
      "line": 77,
      "text": "  const cursor = params.get('cursor'), count = params.get('count'), scene = params.get('scene');"
    },
    {
      "line": 78,
      "text": "  if (cursor === null || cursor.length > 256 || /[\\u0000-\\u0020\\u007f]/.test(cursor) || !/^[0-9]{1,3}$/.test(count ?? '') ||"
    },
    {
      "line": 79,
      "text": "      Number(count) < 1 || Number(count) > 100 || !['0', '1', '2'].includes(scene)) fail('forbidden_query');"
    },
    {
      "line": 80,
      "text": "}"
    },
